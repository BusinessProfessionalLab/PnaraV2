## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

.vs/
.idea/
*.user
*.suo
bin/
obj/
[Bb]uild/
artifacts/
*.dll
*.exe
*.pdb
*.cache
*.log
logs/
tickets/
appsettings.*.local.json
*.nupkg

# OS
.DS_Store
Thumbs.db

# Node (phase 2)
node_modules/
.next/
out/

## =========================================================================
## 1. JAVASCRIPT / NODE DEPENDENCIES (STRICTLY NODE_MODULES ONLY)
## =========================================================================
# Ignores any node_modules directory at root or nested anywhere in the tree
**/node_modules/
node_modules/


## =========================================================================
## 2. .NET / C# CORE BUILD ARTIFACTS & CACHES
## =========================================================================
# Build binaries and intermediate files
[Bb]in/
[Oo]bj/
[Aa]rms/
[Aa]rm64/
[Dd]ebug/
[Rr]elease/
x64/
x86/

# Publish output directories
publish/
[Pp]ublish[Oo]utput/
*.Publish.xml
*.pubxml
*.pubxml.user

# NuGet packages & project assets cache
*.nuget.props
*.nuget.targets
project.lock.json
project.assets.json
*.nugetcache
nuget.config.user


## =========================================================================
## 3. VISUAL STUDIO & VISUAL STUDIO CODE SPECIFICS
## =========================================================================
# Visual Studio temporary, user, and state files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.dbmdl

# VS Code workspace settings (uncomment extensions.json if you want to enforce recommended plugins)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.code-workspace

# JetBrains Rider / Resharper
.idea/
*.sln.DotSettings.user
_ReSharper*/


## =========================================================================
## 4. SECRETS, CONFIGS & ENVIRONMENT SPECIFICS
## =========================================================================
# Local overrides & production secrets (Keep appsettings.json and appsettings.Development.json tracked!)
appsettings.*.local.json
appsettings.Production.json
secrets.json
.env
.env.*
!.env.example


## =========================================================================
## 5. DATABASE MIGRATIONS, LOCAL STORAGE & ATTACHED DBs
## =========================================================================
# Local SQL Server MDF/LDF files
*.mdf
*.ldf
*.ndf

# SQLite database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# EF Core bundle artifacts
efbundle
efbundle.exe


## =========================================================================
## 6. LOGS, CRASH DUMPS & DIAGNOSTICS
## =========================================================================
# Application & Web Server Logs (Serilog, NLog, Log4Net, IIS)
[Ll]og/
[Ll]ogs/
*.log
_logs/

# Memory dumps and profiler snapshots
*.dmp
*.hdmp
*.mdmp
*.vsp
*.vspx
*.sap
*.dotCover


## =========================================================================
## 7. TESTING, CODE COVERAGE & BENCHMARKING
## =========================================================================
# Test results and coverage reports (Coverlet, FineCodeCoverage, TestResults)
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
coverage/
BenchmarkDotNet.Artifacts/


## =========================================================================
## 8. OS METADATA & SYSTEM JUNK
## =========================================================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
