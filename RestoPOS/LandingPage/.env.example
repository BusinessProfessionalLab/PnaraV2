[TEMPLATE]
# Site Configuration
# The production domain. Canonical URLs, Open Graph tags and the sitemap all
# build from this value — set it before deploying.
PUBLIC_SITE_URL=https://pnara.ir

# Analytics (optional — leave blank to disable)
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA4_ID=

# Umami analytics website ID
PUBLIC_UMAMI_ID=

# Live chat (Astro widget -> Cloudflare Worker API)
# Base URL of the Worker that serves /api/chat/* (no trailing slash).
# Must match the Worker deployment; placeholders only, never secrets.
PUBLIC_CHAT_API_URL=https://pnara-sup01.mr-2donya9034.workers.dev
