[TEMPLATE]
# Site Configuration
# The production domain. Canonical URLs, Open Graph tags and the sitemap all
# build from this value — set it before deploying.
PUBLIC_SITE_URL=https://pnara.ir

# Analytics (optional — leave blank to disable)
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA4_ID=

# Umami analytics website ID
PUBLIC_UMAMI_ID=
