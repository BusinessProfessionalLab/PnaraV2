---
/**
 * Port of the Framer "Buttons/Form button" component.
 * States mirror its variants: Default, Loading, Disabled, Success, Error.
 * Anatomy matches Buttons/button — a 36px Brand chip holding a 25px chevron
 * window plus a 20px spinner, and an 18px label roller.
 */
export interface Props {
  label: string;
  state?: 'default' | 'loading' | 'disabled' | 'success' | 'error';
  type?: 'submit' | 'button';
  class?: string;
}
const { label, state = 'default', type = 'submit', class: extra = '' } = Astro.props;
---
<button
  class={`fbtn fbtn--primary formbtn is-${state} ${extra}`.trim()}
  type={type}
  data-form-button
  disabled={state === 'disabled'}
  aria-busy={state === 'loading' ? 'true' : undefined}
>
  <span class="fbtn__chip">
    <span class="fbtn__arrows"
      ><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6.5 15 12l-5.5 5.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg
      ><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6.5 15 12l-5.5 5.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg
    ></span>
    <span class="formbtn__check" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="m6 12.5 4 4 8-9" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <span class="formbtn__spinner" aria-hidden="true"><i></i></span>
  </span>
  <span class="fbtn__label"><span>{label}</span><span aria-hidden="true">{label}</span></span>
</button>
