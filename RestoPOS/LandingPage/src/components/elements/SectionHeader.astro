---
const { title, description, eyebrow } = Astro.props;
---

<div class="relative z-20 w-full mx-auto mt-12 mb-10 md:mb-14 text-center">
  {eyebrow && (
    <p class="mb-5">
      <span class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{eyebrow}</span>
    </p>
  )}
  <h2
    class="text-3xl sm:text-4xl lg:text-[2.75rem] lg:leading-[1.3] font-brand text-center tracking-normal text-balance"
  >
    {title}
  </h2>
  {description && (
    <div
      class="mt-4 text-sm leading-7 sm:mt-5 sm:leading-8 lg:text-lg text-neutral-500 dark:text-neutral-400 max-w-full lg:max-w-2xl m-auto text-balance"
    >
      {description}
    </div>
  )}
</div>
