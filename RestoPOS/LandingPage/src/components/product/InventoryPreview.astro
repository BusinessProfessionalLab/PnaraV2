---
/**
 * Inventory screen mockup (`/admin/inventory`).
 *
 * Mirrors the real screen in `frontend/src/components/admin/inventory-hub.tsx`:
 * tabs (`کالاها / خرید / ضایعات / انبارگردانی / انتقال / تأمین‌کنندگان`),
 * reorder-point alerts, live stock table (کالا / SKU / موجودی / حداقل موجودی /
 * بهای میانگین / وضعیت), weighted-average costing, cardex ledger, purchase
 * invoices with payment status (`پرداخت‌شده / پرداخت‌نشده / پرداخت جزئی`),
 * waste with exact reasons (`انقضا / اشکال آماده‌سازی / فساد / وعده پرسنل /
 * ریخت‌وپاش / شکستگی`), stock counts, inter-location transfers, suppliers,
 * manual adjustments, and valuation by location.
 * Units: `گرم / میلی‌لیتر / عدد / پرس / قوطی / کیلوگرم / لیتر`.
 * Locations: `انبار مرکزی / خط آشپزخانه / بار / سردخانه / انبار خشک`.
 */
import { TriangleAlert, ArrowDownToLine, ArrowUpRight, Boxes, Truck, ClipboardCheck } from "@lucide/astro";
import { formatToman, fa } from "@/lib/fa";

const tabs = ["کالاها", "خرید", "ضایعات", "انبارگردانی", "انتقال", "تأمین‌کنندگان"];

const stock = [
  {
    name: "دانه اسپرسو (Dark Roast)",
    sku: "ESB-001",
    stock: 1.4,
    unit: "کیلوگرم",
    min: 2,
    avgRial: 32_000_000,
    status: "low",
  },
  {
    name: "شیر پرچرب ۱ لیتری",
    sku: "MLK-101",
    stock: 24,
    unit: "لیتر",
    min: 12,
    avgRial: 3_100_000,
    status: "ok",
  },
  {
    name: "شیر بادام",
    sku: "AML-210",
    stock: 0,
    unit: "لیتر",
    min: 6,
    avgRial: 8_900_000,
    status: "out",
  },
  {
    name: "پودر کاکائو",
    sku: "CCO-330",
    stock: 2.6,
    unit: "کیلوگرم",
    min: 1,
    avgRial: 14_500_000,
    status: "ok",
  },
];

const statusMeta = {
  ok: { label: "سالم", cls: "bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 border border-emerald-600/20" },
  low: { label: "رو به اتمام", cls: "bg-amber-400/15 text-amber-800 dark:text-amber-300 border border-amber-400/25" },
  out: { label: "ناموجود", cls: "bg-[#c02f2f]/10 text-[#c02f2f] dark:text-[#f06a70] border border-[#c02f2f]/20" },
};

const transactions = [
  { name: "دانه اسپرسو (Dark Roast)", type: "خرید", delta: "+۵ کیلوگرم", dir: "in" },
  { name: "شیر پرچرب ۱ لیتری", type: "مصرف رسپی", delta: "−۰٫۳۶ لیتر", dir: "out" },
  { name: "پودر کاکائو", type: "ضایعات · فساد", delta: "−۱٫۲ کیلوگرم", dir: "waste" },
  { name: "شیر بادام", type: "تعدیل شمارش", delta: "−۲ لیتر", dir: "waste" },
];

const dust = {
  in: "bg-emerald-600/10 text-emerald-700 dark:text-emerald-400",
  out: "bg-[#f0f2f5] text-[#5d6675] dark:bg-[#20252f] dark:text-[#9aa4b5]",
  waste: "bg-[#c02f2f]/10 text-[#c02f2f] dark:text-[#f06a70]",
};
---

<div class="flex flex-col bg-[#f7f8fa] dark:bg-[#0e1117]">
  <!-- Real tabs -->
  <div class="flex gap-1 overflow-x-auto px-3 sm:px-4 py-2.5 border-b border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
    {
      tabs.map((t, i) => (
        <span
          class:list={[
            "shrink-0 px-3 py-1.5 rounded-lg text-[11px] font-semibold whitespace-nowrap",
            i === 0
              ? "bg-[#f0f2f5] dark:bg-[#20252f] text-[#1a1d24] dark:text-[#e8ebf1]"
              : "text-[#5d6675] dark:text-[#9aa4b5]",
          ]}
        >
          {t}
        </span>
      ))
    }
  </div>

  <!-- Valuation strip -->
  <div class="flex flex-wrap items-center gap-2 px-4 py-3 border-b border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
    <span class="inline-flex items-center gap-1.5 text-[11px] text-[#5d6675] dark:text-[#9aa4b5]">
      <Boxes class="w-3.5 h-3.5 text-[#C41E3A]" aria-hidden="true" />
      ارزش کل انبار
    </span>
    <span class="text-[12px] font-black text-[#1a1d24] dark:text-[#e8ebf1] tabular-nums">{formatToman(412_600_000)}</span>
    <span class="ms-auto inline-flex items-center gap-1.5 text-[10px] text-[#5d6675] dark:text-[#9aa4b5]">
      <Truck class="w-3 h-3" aria-hidden="true" />
      انبار مرکزی · خط آشپزخانه · بار · سردخانه · انبار خشک
    </span>
  </div>

  <!-- Reorder-point alerts -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 p-3 sm:p-4">
    {
      stock
        .filter((s) => s.status !== "ok")
        .map((s) => (
          <div class="rounded-xl border border-amber-400/30 bg-amber-400/[0.06] dark:bg-amber-400/[0.04] p-3 flex items-start gap-2.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-amber-400/15 text-amber-700 dark:text-amber-300">
              <TriangleAlert class="w-4 h-4" aria-hidden="true" />
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[11px] font-bold text-[#1a1d24] dark:text-[#e8ebf1] truncate">{s.name}</div>
              <div class="text-[10px] text-[#5d6675] dark:text-[#9aa4b5] tabular-nums">
                <span class="font-latin" dir="ltr">{s.sku}</span> · حداقل موجودی {fa(s.min)} {s.unit}
              </div>
              <div class="mt-1.5 flex items-center justify-between gap-2">
                <span class="text-[10px] text-[#5d6675] dark:text-[#9aa4b5]">
                  موجودی فعلی:
                  <span class="font-bold text-[#1a1d24] dark:text-[#e8ebf1] tabular-nums">{fa(s.stock)}</span>
                </span>
                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-400/20 text-amber-800 dark:text-amber-200 tabular-nums">
                  کسری {fa(Math.max(0, s.min - s.stock))}
                </span>
              </div>
            </div>
          </div>
        ))
    }
  </div>

  <!-- Live stock table -->
  <div class="border-t border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
    <div class="flex items-center gap-2 px-4 py-3">
      <Boxes class="w-3.5 h-3.5 text-[#C41E3A]" aria-hidden="true" />
      <span class="text-[12px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">موجودی زنده</span>
      <span class="ms-auto px-2 py-0.5 rounded-md text-[10px] font-medium bg-[#f0f2f5] text-[#5d6675] dark:bg-[#20252f] dark:text-[#9aa4b5] tabular-nums">
        {fa(4)} کالا
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-start border-collapse">
        <thead>
          <tr class="border-y border-[#e2e5ea] dark:border-[#272d39] bg-[#f7f8fa] dark:bg-[#0e1117]">
            {
              ["کالا", "SKU", "موجودی", "حداقل موجودی", "بهای میانگین", "وضعیت"].map((h) => (
                <th
                  class="px-3 py-2 text-[10px] font-medium text-[#5d6675] dark:text-[#9aa4b5] whitespace-nowrap text-start"
                  scope="col"
                >
                  {h}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            stock.map((s) => (
              <tr class="border-b border-[#e2e5ea]/50 dark:border-[#272d39]/50">
                <td class="px-3 py-2.5 text-[11px] font-semibold text-[#1a1d24] dark:text-[#e8ebf1] whitespace-nowrap">
                  {s.name}
                </td>
                <td class="px-3 py-2.5 font-latin text-[10px] text-[#5d6675] dark:text-[#9aa4b5]" dir="ltr">
                  {s.sku}
                </td>
                <td class="px-3 py-2.5 text-[11px] tabular-nums whitespace-nowrap">
                  <span class="font-bold text-[#1a1d24] dark:text-[#e8ebf1]">{fa(s.stock)}</span>{" "}
                  <span class="text-[10px] text-[#5d6675] dark:text-[#9aa4b5]">{s.unit}</span>
                </td>
                <td class="px-3 py-2.5 text-[10px] text-[#5d6675] dark:text-[#9aa4b5] tabular-nums whitespace-nowrap">
                  {fa(s.min)} {s.unit}
                </td>
                <td class="px-3 py-2.5 text-[10px] text-[#5d6675] dark:text-[#9aa4b5] tabular-nums whitespace-nowrap">
                  {formatToman(s.avgRial)}
                </td>
                <td class="px-3 py-2.5">
                  <span class={`px-1.5 py-0.5 rounded text-[9px] font-bold whitespace-nowrap ${statusMeta[s.status as keyof typeof statusMeta].cls}`}>
                    {statusMeta[s.status as keyof typeof statusMeta].label}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="px-4 py-2.5 border-t border-dashed border-[#e2e5ea] dark:border-[#272d39]">
      <span class="text-[10px] text-[#5d6675] dark:text-[#9aa4b5]">
        بهای میانگین موزون با هر فاکتور خرید به‌روز می‌شود — همین عدد مبنای بهای تمام‌شده و حاشیه سود است. فاکتورها پیش‌نویس / تأییدشده / لغوشده‌اند و وضعیت پرداخت‌شان مشخص است.
      </span>
    </div>
  </div>

  <!-- Stock transactions / cardex feed -->
  <div class="border-t border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
    <div class="flex items-center gap-2 px-4 py-3">
      <ClipboardCheck class="w-3.5 h-3.5 text-[#C41E3A]" aria-hidden="true" />
      <span class="text-[12px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">گردش انبار · کاردکس</span>
    </div>
    <ul class="divide-y divide-[#e2e5ea]/50 dark:divide-[#272d39]/50">
      {
        transactions.map((t) => (
          <li class="flex items-center gap-3 px-4 py-2.5">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#f0f2f5] dark:bg-[#20252f] text-[#5d6675] dark:text-[#9aa4b5]">
              {t.dir === "in" ? (
                <ArrowDownToLine class="w-3.5 h-3.5" aria-hidden="true" />
              ) : (
                <ArrowUpRight class="w-3.5 h-3.5" aria-hidden="true" />
              )}
            </span>
            <div class="min-w-0 flex-1 flex flex-wrap items-center gap-2">
              <span class="text-[11px] font-semibold text-[#1a1d24] dark:text-[#e8ebf1] truncate">{t.name}</span>
              <span class={`px-1.5 py-0.5 rounded text-[9px] font-bold ${dust[t.dir as keyof typeof dust]}`}>{t.type}</span>
              <span class="text-[10px] font-medium text-[#1a1d24] dark:text-[#e8ebf1] tabular-nums">{t.delta}</span>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="px-4 py-2.5 border-t border-dashed border-[#e2e5ea] dark:border-[#272d39]">
      <span class="text-[10px] text-[#5d6675] dark:text-[#9aa4b5]">
        هر حرکت کاردکس موجودی قبل و بعد، بهای واحد و مرجعش را دارد. ضایعات با علت ثبت می‌شود: انقضا، اشکال آماده‌سازی، فساد، وعده پرسنل، ریخت‌وپاش / شکستگی.
      </span>
    </div>
  </div>
</div>
