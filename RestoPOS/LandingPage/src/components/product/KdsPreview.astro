---
/**
 * Kitchen / bar display mockup (`/kds` and `/kds/kitchen`).
 *
 * Mirrors the real board: station title with a live connection badge, ticket
 * cards carrying the order number, table, total and elapsed time, per-item
 * modifiers and highlighted preparation notes, and the exact status actions the
 * barista or cook taps (`شروع آماده‌سازی` / `آماده شد`).
 */
import { ChefHat, CirclePlay, CircleCheckBig, Radio, Coffee } from "@lucide/astro";
import { formatToman, fa } from "@/lib/fa";

const tickets = [
  {
    number: "1024",
    table: "۷",
    rial: 5_005_000,
    status: "in-prep",
    elapsed: "۴ دقیقه",
    items: [
      { qty: 2, title: "لاته", modifiers: ["شیر بادام", "شات اضافه"], note: "بدون شکر" },
      { qty: 1, title: "آیس لاته", modifiers: [], note: null },
    ],
  },
  {
    number: "1025",
    table: "۱۲",
    rial: 2_400_000,
    status: "submitted",
    elapsed: "همین حالا",
    items: [{ qty: 2, title: "کاپوچینو", modifiers: ["شیر بدون لاکتوز"], note: "خیلی گرم" }],
  },
];

const STATUS = {
  "in-prep": { label: "در حال آماده‌سازی", cls: "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300" },
  submitted: { label: "در انتظار شروع", cls: "bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light" },
  ready: { label: "آماده تحویل", cls: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400" },
};
---

<div class="flex flex-col">
  <!-- Station header -->
  <div class="flex items-center gap-3 px-4 py-3 border-b border-neutral-200/70 dark:border-neutral-700/60 bg-bg-primary/40 dark:bg-neutral-900/40">
    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/12 text-primary shrink-0">
      <Coffee class="w-4 h-4" aria-hidden="true" />
    </span>
    <div class="min-w-0 flex-1">
      <div class="text-[12px] font-bold text-neutral-800 dark:text-neutral-100">نمایشگر بار</div>
      <div class="text-[10px] text-neutral-400 dark:text-neutral-500">۲ سفارش فعال · بار · به‌روزرسانی زنده</div>
    </div>
    <span
      class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400"
    >
      <span class="app-dot-ping relative w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      متصل
    </span>
  </div>

  <!-- Tickets -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-3 sm:p-4 bg-bg-primary/20 dark:bg-neutral-950/20">
    {
      tickets.map((t) => {
        const status = STATUS[t.status as keyof typeof STATUS];
        return (
          <div class="rounded-2xl border border-primary/10 dark:border-neutral-700 bg-bg-secondary dark:bg-bg-secondary-dark p-4 flex flex-col gap-3">
            <div class="flex items-start justify-between gap-2">
              <div>
                <div class="text-lg font-bold text-neutral-900 dark:text-neutral-50 tabular-nums leading-none" dir="ltr">
                  #{t.number}
                </div>
                <div class="mt-1.5 flex flex-wrap items-center gap-x-1.5 text-[11px] text-neutral-400 dark:text-neutral-500">
                  <span>میز {t.table}</span>
                  <span aria-hidden="true">·</span>
                  <span class="font-medium text-neutral-600 dark:text-neutral-300 tabular-nums">
                    {formatToman(t.rial)}
                  </span>
                </div>
              </div>
              <div class="flex flex-col items-end gap-1">
                <span class={`px-2 py-0.5 rounded-md text-[10px] font-medium ${status.cls}`}>{status.label}</span>
                <span class="text-[10px] text-neutral-400 dark:text-neutral-500 tabular-nums">{t.elapsed}</span>
              </div>
            </div>

            <ul class="border-y border-dashed border-neutral-200/70 dark:border-neutral-700/60 divide-y divide-dashed divide-neutral-200/70 dark:divide-neutral-700/60">
              {t.items.map((item) => (
                <li class="py-2">
                  <div class="text-[13px] font-bold text-neutral-800 dark:text-neutral-100">
                    <span class="tabular-nums">{fa(item.qty)}×</span> {item.title}
                  </div>
                  {item.modifiers.length > 0 && (
                    <div class="mt-1 space-y-0.5">
                      {item.modifiers.map((m: string) => (
                        <div class="flex items-center gap-1.5 text-[11px] text-neutral-500 dark:text-neutral-400">
                          <Radio class="w-2.5 h-2.5 rotate-90 text-neutral-300 dark:text-neutral-600" aria-hidden="true" />
                          {m}
                        </div>
                      ))}
                    </div>
                  )}
                  {item.note && (
                    <span class="mt-1.5 inline-flex rounded-lg bg-amber-400/15 px-2 py-0.5 text-[11px] font-semibold text-amber-700 dark:text-amber-300">
                      {item.note}
                    </span>
                  )}
                </li>
              ))}
            </ul>

            <div class="mt-auto">
              {t.status === "in-prep" ? (
                <div class="flex items-center justify-center gap-2 rounded-xl py-2.5 text-[12px] font-semibold bg-green-600 text-white">
                  <CircleCheckBig class="w-4 h-4" aria-hidden="true" />
                  آماده شد
                </div>
              ) : (
                <div class="flex items-center justify-center gap-2 rounded-xl py-2.5 text-[12px] font-semibold bg-primary text-white">
                  <CirclePlay class="w-4 h-4" aria-hidden="true" />
                  شروع آماده‌سازی
                </div>
              )}
            </div>
          </div>
        );
      })
    }
  </div>

  <!-- Station split note -->
  <div class="flex items-center gap-2 px-4 py-2.5 border-t border-dashed border-neutral-200/70 dark:border-neutral-700/60">
    <ChefHat class="w-3.5 h-3.5 text-neutral-400 dark:text-neutral-500" aria-hidden="true" />
    <span class="text-[10px] text-neutral-400 dark:text-neutral-500">
      هر آیتم و افزودنی، ایستگاه بلیت خودش را دارد — بار و آشپزخانه فقط ردیف‌های خودشان را می‌بینند.
    </span>
  </div>
</div>

<style>
  .app-dot-ping::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: currentColor;
    color: rgb(16, 185, 129);
    animation: app-dot-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes app-dot-ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    80%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .app-dot-ping::before {
      animation: none;
    }
  }
</style>
