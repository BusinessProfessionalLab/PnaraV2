---
/**
 * Kitchen / bar display mockup (`/kds` and `/kds/kitchen`).
 *
 * Mirrors the real board in `frontend/src/components/kds/kds-board.tsx`:
 * sticky `h-16` header with station title + `{n} سفارش فعال · بار/آشپزخانه ·
 * به‌روزرسانی زنده`, live badge (`متصل / قطع / در حال اتصال`) over SignalR
 * (`OrderUpdated / KitchenTicket / BarTicket` + ۸s refetch fallback), ticket
 * cards (`rounded-2xl border bg-card p-5`) carrying order number / table /
 * total / elapsed (`همین حالا / N دقیقه`), per-item modifiers with quantity
 * and highlighted preparation notes (`bg-warning/10 text-warning`), and the
 * exact status actions (`شروع آماده‌سازی / آماده شد / آماده تحویل است`).
 * Statuses: `در انتظار شروع / در حال آماده‌سازی / آماده تحویل`.
 * Page canvas is `#eef1f5` (`bg-canvas`); empty state is «هیچ سفارش فعالی نیست».
 */
import { ChefHat, CirclePlay, CircleCheckBig, Radio, Coffee, Wifi } from "@lucide/astro";
import { formatToman, fa } from "@/lib/fa";

const tickets = [
  {
    number: "1024",
    table: "۷",
    rial: 5_005_000,
    status: "in-prep",
    elapsed: "۴ دقیقه",
    items: [
      { qty: 2, title: "لاته", modifiers: [{ name: "شیر بادام", qty: 1 }, { name: "شات اضافه", qty: 2 }], note: "بدون شکر" },
      { qty: 1, title: "آیس لاته", modifiers: [], note: null },
    ],
  },
  {
    number: "1025",
    table: "۱۲",
    rial: 2_400_000,
    status: "submitted",
    elapsed: "همین حالا",
    items: [{ qty: 2, title: "کاپوچینو", modifiers: [{ name: "شیر بدون لاکتوز", qty: 1 }], note: "خیلی گرم" }],
  },
  {
    number: "1023",
    table: "۳",
    rial: 1_900_000,
    status: "ready",
    elapsed: "۱۲ دقیقه",
    items: [{ qty: 1, title: "موکا", modifiers: [], note: null }],
  },
];

const STATUS = {
  submitted: { label: "در انتظار شروع", cls: "bg-[#eef1f5] text-[#1a1d24] dark:bg-[#242a35] dark:text-[#e8ebf1] border border-[#e2e5ea] dark:border-[#272d39]" },
  "in-prep": { label: "در حال آماده‌سازی", cls: "bg-amber-400/15 text-amber-800 dark:text-amber-300 border border-amber-400/25" },
  ready: { label: "آماده تحویل", cls: "bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 border border-emerald-600/25" },
};
---

<div class="flex flex-col bg-[#eef1f5] dark:bg-[#0a0d12]">
  <!-- Station header: h-16, brand tile, title + live subtitle, live badge -->
  <div class="flex items-center gap-3 px-4 sm:px-6 h-16 border-b border-[#e2e5ea] dark:border-[#272d39] bg-white/90 dark:bg-[#151923]/90 backdrop-blur">
    <span class="flex size-9 items-center justify-center rounded-xl bg-[#C41E3A]/10 text-[#C41E3A] shrink-0">
      <Coffee class="w-[18px] h-[18px]" aria-hidden="true" />
    </span>
    <div class="min-w-0 flex-1">
      <div class="truncate text-[15px] font-bold leading-5 text-[#1a1d24] dark:text-[#e8ebf1]">نمایشگر بار</div>
      <div class="text-[11px] text-[#5d6675] dark:text-[#9aa4b5] tabular-nums">{fa(3)} سفارش فعال · بار · به‌روزرسانی زنده</div>
    </div>
    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 border border-emerald-600/20">
      <Wifi class="w-3 h-3" aria-hidden="true" />
      متصل
    </span>
  </div>

  <!-- Tickets: grid md:2 lg:3, Card p-5 rounded-2xl -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 p-3 sm:p-4">
    {
      tickets.map((t) => {
        const status = STATUS[t.status as keyof typeof STATUS];
        return (
          <div class="rounded-2xl border border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923] p-5 flex flex-col gap-3 shadow-[0_1px_2px_0_rgb(17_24_39/0.04)]">
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="text-2xl font-black tracking-tight tabular-nums text-[#1a1d24] dark:text-[#e8ebf1] leading-none" dir="ltr">
                  #{t.number}
                </div>
                <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[13px] text-[#5d6675] dark:text-[#9aa4b5]">
                  <span>میز {t.table}</span>
                  <span aria-hidden="true">·</span>
                  <span class="font-medium text-[#1a1d24] dark:text-[#e8ebf1] tabular-nums">
                    {formatToman(t.rial)}
                  </span>
                </div>
              </div>
              <div class="flex flex-col items-end gap-1.5">
                <span class={`px-2 py-0.5 rounded-md text-[10px] font-semibold ${status.cls}`}>{status.label}</span>
                <span class="text-[11px] tabular-nums text-[#5d6675] dark:text-[#9aa4b5]">{t.elapsed}</span>
              </div>
            </div>

            <ul class="divide-y divide-[#e2e5ea]/60 dark:divide-[#272d39]/60 border-y border-[#e2e5ea]/60 dark:border-[#272d39]/60">
              {t.items.map((item) => (
                <li class="py-2.5">
                  <div class="text-[15px] font-bold leading-6 text-[#1a1d24] dark:text-[#e8ebf1]">
                    <span class="tabular-nums">{fa(item.qty)}×</span> {item.title}
                  </div>
                  {item.modifiers.length > 0 && (
                    <div class="mt-1 space-y-0.5">
                      {item.modifiers.map((m: { name: string; qty: number }) => (
                        <div class="flex items-center gap-1.5 text-[13px] text-[#5d6675] dark:text-[#9aa4b5]">
                          <Radio class="w-3 h-3 rotate-90 text-[#cdd3db] dark:text-[#3b4353]" aria-hidden="true" />
                          {m.name}
                          {m.qty > 1 && <span class="tabular-nums">× {fa(m.qty)}</span>}
                        </div>
                      ))}
                    </div>
                  )}
                  {item.note && (
                    <p class="mt-1.5 inline-flex rounded-lg bg-amber-400/10 px-2 py-1 text-[13px] font-semibold text-amber-800 dark:text-amber-300">
                      {item.note}
                    </p>
                  )}
                </li>
              ))}
            </ul>

            <div class="mt-auto flex gap-2 pt-1">
              {t.status === "submitted" ? (
                <div class="flex h-12 flex-1 items-center justify-center gap-2 rounded-xl text-[13px] font-bold bg-[#C41E3A] text-white">
                  <CirclePlay class="w-5 h-5" aria-hidden="true" />
                  شروع آماده‌سازی
                </div>
              ) : t.status === "in-prep" ? (
                <div class="flex h-12 flex-1 items-center justify-center gap-2 rounded-xl text-[13px] font-bold bg-emerald-700 text-white">
                  <CircleCheckBig class="w-5 h-5" aria-hidden="true" />
                  آماده شد
                </div>
              ) : (
                <div class="flex w-full items-center justify-center gap-2 rounded-xl border border-emerald-600/25 bg-emerald-600/10 py-3 text-[13px] font-bold text-emerald-700 dark:text-emerald-400">
                  <CircleCheckBig class="w-5 h-5" aria-hidden="true" />
                  آماده تحویل است
                </div>
              )}
            </div>
          </div>
        );
      })
    }
  </div>

  <!-- Station split note -->
  <div class="flex items-center gap-2 px-4 py-2.5 border-t border-dashed border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
    <ChefHat class="w-3.5 h-3.5 text-[#5d6675] dark:text-[#9aa4b5]" aria-hidden="true" />
    <span class="text-[10px] text-[#5d6675] dark:text-[#9aa4b5]">
      هر آیتم و افزودنی، ایستگاه بلیت خودش را دارد — بار و آشپزخانه فقط ردیف‌های خودشان را می‌بینند. سفارش جدید با صدا اعلام می‌شود.
    </span>
  </div>
</div>
