---
/**
 * POS register mockup (`/pos`).
 *
 * Every element here mirrors the real touch register in `frontend/`:
 * category tabs with live counts, fuzzy search over name/category/SKU
 * (`pos-register.tsx`: «جستجو بر اساس نام، دسته یا SKU مواد…»), order type
 * + table number (`DineIn=حضوری / Takeaway=بیرون‌بر / Bar=سالن`), per-item
 * modifiers and preparation notes, the stock signals on the product tiles
 * (`موجود / نزدیک اتمام / ناموجود`), discount strikethrough + ٪ badge, the
 * loyal-customer badge, multi-add mode, and a live receipt panel with Toman
 * totals (`جمع جزء / ارزش افزوده (٪) / قابل پرداخت`).
 *
 * Prices are held in Rial and rendered in Toman by `formatToman()`, the same
 * conversion the product performs. Surfaces follow the product's own tokens:
 * page `#f7f8fa`, canvas `#eef1f5`, card `#ffffff`, border `#e2e5ea`,
 * foreground `#1a1d24`, brand `#C41E3A` (the shipped default; the store can
 * recolor it from Settings). Dark values mirror `frontend/.../globals.css`.
 */
import { Coffee, Search, ShoppingBasket, Sparkles, Wifi, ListPlus } from "@lucide/astro";
import { formatToman, fa } from "@/lib/fa";

const categories = [
  { name: "همه", count: 24, active: true },
  { name: "قهوه گرم", count: 6 },
  { name: "قهوه سرد", count: 5 },
  { name: "دمنوش", count: 4 },
  { name: "کیک و دسر", count: 5 },
  { name: "صبحانه", count: 4 },
];

const products = [
  { title: "لاته", rial: 1_200_000, stock: "ok", discountPercent: 0 },
  { title: "کاپوچینو", rial: 1_100_000, stock: "ok", discountPercent: 10 },
  { title: "اسپرسو دوپیو", rial: 850_000, stock: "ok", discountPercent: 0 },
  { title: "آیس لاته", rial: 1_450_000, stock: "low", discountPercent: 0 },
  { title: "موکا", rial: 1_350_000, stock: "ok", discountPercent: 0 },
  { title: "چای ماسالا", rial: 950_000, stock: "out", discountPercent: 0 },
];

const stockMeta = {
  ok: { label: "موجود", cls: "bg-emerald-600/90 text-white" },
  low: { label: "نزدیک اتمام", cls: "bg-amber-400/95 text-amber-950" },
  out: { label: "ناموجود", cls: "bg-[#1a1d24]/80 text-white dark:bg-black/70 dark:text-neutral-200" },
};

const lines = [
  {
    title: "لاته",
    qty: 2,
    rial: 1_200_000,
    modifiers: ["شیر بادام", "شات اضافه"],
    note: "بدون شکر",
  },
  { title: "آیس لاته", qty: 1, rial: 1_450_000, modifiers: [], note: null },
];

// Receipt totals, computed exactly like the register does
// (`priceCart`: جمع جزء → ارزش افزوده → قابل پرداخت).
const subtotal = lines.reduce((sum, l) => sum + l.rial * l.qty, 0);
const vatRate = 0.1;
const vatTotal = Math.round(subtotal * vatRate);
const grandTotal = subtotal + vatTotal;
const itemCount = lines.reduce((s, l) => s + l.qty, 0);
---

<div class="grid grid-cols-1 md:grid-cols-[320px_1fr] lg:grid-cols-[340px_1fr] bg-[#f7f8fa] dark:bg-[#0e1117]">
  <!-- ── Product picker ─────────────────────────────────────────────── -->
  <div class="flex flex-col min-w-0 border-b md:border-b-0 md:border-s border-[#e2e5ea] dark:border-[#272d39] bg-[#f7f8fa] dark:bg-[#0e1117]">
    <!-- Register toolbar: search + order type + table -->
    <div class="flex flex-wrap items-center gap-2 px-3 sm:px-4 py-3 border-b border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
      <div class="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-[#f0f2f5] dark:bg-[#20252f] border border-[#e2e5ea] dark:border-[#272d39] min-w-0 flex-1">
        <Search class="w-3.5 h-3.5 text-[#5d6675] dark:text-[#9aa4b5] shrink-0" aria-hidden="true" />
        <span class="text-[11px] text-[#5d6675] dark:text-[#9aa4b5] truncate">جستجو بر اساس نام، دسته یا SKU مواد…</span>
      </div>

      <div class="flex items-center rounded-xl border border-[#e2e5ea] dark:border-[#272d39] p-0.5 gap-0.5 bg-white dark:bg-[#151923]">
        <span class="px-2.5 py-1.5 rounded-lg text-[11px] font-semibold bg-[#C41E3A] text-white">حضوری</span>
        <span class="px-2.5 py-1.5 rounded-lg text-[11px] font-medium text-[#5d6675] dark:text-[#9aa4b5]">بیرون‌بر</span>
        <span class="px-2.5 py-1.5 rounded-lg text-[11px] font-medium text-[#5d6675] dark:text-[#9aa4b5]">سالن</span>
      </div>

      <span class="px-2.5 py-1.5 rounded-xl text-[11px] font-semibold bg-[#f0f2f5] dark:bg-[#20252f] border border-[#e2e5ea] dark:border-[#272d39] text-[#1a1d24] dark:text-[#e8ebf1] tabular-nums">میز ۷</span>
    </div>

    <!-- Category tabs -->
    <!-- Wraps instead of scrolling: the mockup is narrower than the real register,
         and a scrolling row would clip pills behind a scrollbar. -->
    <div class="flex flex-wrap items-center gap-1.5 px-3 sm:px-4 py-2.5 border-b border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
      {
        categories.map((c) => (
          <span
            class:list={[
              "shrink-0 inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-[11px] font-semibold whitespace-nowrap",
              c.active
                ? "border-transparent bg-[#C41E3A] text-white shadow-sm"
                : "border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923] text-[#5d6675] dark:text-[#9aa4b5]",
            ]}
          >
            {c.name}
            <span
              class:list={[
                "rounded-full px-1.5 py-px text-[9px] font-bold tabular-nums",
                c.active
                  ? "bg-white/20 text-white"
                  : "bg-[#f0f2f5] text-[#5d6675] dark:bg-[#20252f] dark:text-[#9aa4b5]",
              ]}
            >
              {fa(c.count)}
            </span>
          </span>
        ))
      }
    </div>

    <!-- Product grid: rounded-2xl cards, aspect-square image, stock badge,
         title 15px bold, price extrabold brand, discount strikethrough + ٪ -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 p-3 sm:p-4">
      {
        products.map((p) => {
          const stock = stockMeta[p.stock as keyof typeof stockMeta];
          const discounted = Math.round(p.rial * (1 - p.discountPercent / 100));
          return (
            <div class="relative flex flex-col rounded-2xl border border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923] shadow-[0_1px_2px_0_rgb(17_24_39/0.04)] overflow-hidden">
              <div class="relative mx-2.5 mt-2.5">
                <div class="relative aspect-square w-full rounded-xl border border-dashed border-[#e2e5ea] dark:border-[#272d39] bg-[#eef1f5] dark:bg-[#0a0d12] flex items-center justify-center">
                  {/* Stand-in for the product photo the real register renders here. */}
                  <Coffee class="w-6 h-6 text-[#C41E3A]/25" aria-hidden="true" />
                  <span class={`absolute end-2 top-2 px-1.5 py-0.5 rounded-md text-[9px] font-bold backdrop-blur-sm ${stock.cls}`}>
                    {stock.label}
                  </span>
                </div>
              </div>
              <div class="flex min-h-0 flex-1 flex-col p-3 pb-3.5">
                <div class="line-clamp-2 text-[13px] leading-6 font-bold break-words text-[#1a1d24] dark:text-[#e8ebf1]">{p.title}</div>
                <div class="mt-auto flex items-center justify-between gap-2 border-t border-[#e2e5ea]/60 dark:border-[#272d39]/60 pt-2.5">
                  {p.discountPercent > 0 ? (
                    <div class="flex min-w-0 flex-col leading-none">
                      <span class="text-[10px] font-medium text-[#5d6675] dark:text-[#9aa4b5] line-through tabular-nums">
                        {formatToman(p.rial)}
                      </span>
                      <span class="mt-1.5 truncate text-[13px] font-extrabold text-[#C41E3A] tabular-nums">
                        {formatToman(discounted)}
                      </span>
                    </div>
                  ) : (
                    <span class="truncate text-[13px] font-extrabold text-[#C41E3A] tabular-nums">
                      {formatToman(p.rial)}
                    </span>
                  )}
                  {p.discountPercent > 0 && (
                    <span class="shrink-0 px-2 py-1 rounded-md text-[10px] font-bold bg-[#c02f2f]/10 text-[#c02f2f] dark:text-[#f06a70] tabular-nums">
                      {fa(p.discountPercent)}٪
                    </span>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Multi-add launcher hint (real register: floating «افزودن چند محصول») -->
    <div class="px-3 sm:px-4 pb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] font-semibold bg-[#C41E3A] text-white shadow-lg shadow-[#C41E3A]/25">
        <ListPlus class="w-3.5 h-3.5" aria-hidden="true" />
        افزودن چند محصول
      </span>
    </div>

    <!-- Mobile cart summary bar: «X آیتم · Y ردیف» + سبد + تسویه -->
    <div class="md:hidden flex items-center gap-2 border-t border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923] px-3 pt-2.5 pb-3">
      <span class="flex min-w-0 flex-1 items-center gap-2.5 rounded-xl text-start">
        <span class="relative flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#C41E3A]/10 text-[#C41E3A]">
          <ShoppingBasket class="w-5 h-5" aria-hidden="true" />
          <span class="absolute -end-1.5 -top-1.5 flex min-w-5 items-center justify-center rounded-full bg-[#C41E3A] px-1 py-0.5 text-[10px] font-bold text-white tabular-nums">
            {fa(itemCount)}
          </span>
        </span>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-[12px] font-semibold leading-4 text-[#1a1d24] dark:text-[#e8ebf1] tabular-nums">
            {fa(itemCount)} آیتم · {fa(lines.length)} ردیف
          </span>
          <span class="mt-0.5 block truncate text-[14px] font-black text-[#C41E3A] tabular-nums">
            {formatToman(grandTotal)}
          </span>
        </span>
      </span>
      <span class="px-3 py-2 rounded-xl text-[11px] font-semibold border border-[#e2e5ea] dark:border-[#272d39] text-[#1a1d24] dark:text-[#e8ebf1]">سبد</span>
      <span class="px-4 py-2 rounded-xl text-[11px] font-semibold bg-[#C41E3A] text-white">تسویه</span>
    </div>
  </div>

  <!-- ── Receipt panel (cart rail w-[20rem], bg-card) ─────────────────── -->
  <!-- First track of the RTL grid, so the receipt sits on the right; the
       order utility pulls this later-in-DOM aside into that first slot. -->
  <aside class="hidden md:order-first md:flex flex-col bg-white dark:bg-[#151923] border-e border-[#e2e5ea] dark:border-[#272d39]">
    <div class="flex items-center justify-between gap-2 px-4 py-3 border-b border-[#e2e5ea] dark:border-[#272d39]">
      <span class="inline-flex items-center gap-2 text-[12px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">
        <ShoppingBasket class="w-4 h-4 text-[#C41E3A]" aria-hidden="true" />
        صورتحساب
      </span>
      {/* Order numbers are generated as Latin identifiers — keep them LTR. */}
      <span class="font-latin text-[10px] text-[#5d6675] dark:text-[#9aa4b5] tabular-nums" dir="ltr">#1024</span>
    </div>

    <!-- Order context + customer + loyalty -->
    <div class="px-4 py-2.5 border-b border-[#e2e5ea] dark:border-[#272d39] bg-[#f0f2f5]/25 dark:bg-[#20252f]/25">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="inline-flex items-center rounded-md bg-[#f0f2f5] dark:bg-[#20252f] px-2 py-0.5 text-[10px] font-medium text-[#5d6675] dark:text-[#9aa4b5]">حضوری</span>
        <span class="inline-flex items-center rounded-md bg-[#f0f2f5] dark:bg-[#20252f] px-2 py-0.5 text-[10px] font-medium text-[#5d6675] dark:text-[#9aa4b5] tabular-nums">میز ۷</span>
        <span class="font-latin text-[10px] font-medium text-[#1a1d24] dark:text-[#e8ebf1] tabular-nums" dir="ltr">0912 345 6789</span>
        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#fad13b]/25 text-amber-800 dark:text-amber-200">
          <Sparkles class="w-2.5 h-2.5" aria-hidden="true" />
          مشتری وفادار — {fa(7)} سفارش قبلی
        </span>
      </div>
    </div>

    <!-- Lines -->
    <div class="flex-1 divide-y divide-[#e2e5ea]/70 dark:divide-[#272d39]/70">
      {
        lines.map((line) => (
          <div class="px-4 py-3">
            <div class="flex items-start justify-between gap-2">
              <span class="text-[12px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">
                {line.title}
                <span class="text-[#5d6675] dark:text-[#9aa4b5] font-medium tabular-nums"> × {fa(line.qty)}</span>
              </span>
              <span class="text-[11px] font-bold text-[#1a1d24] dark:text-[#e8ebf1] tabular-nums">
                {formatToman(line.rial * line.qty)}
              </span>
            </div>
            {line.modifiers.length > 0 && (
              <div class="flex flex-wrap gap-1 mt-1.5">
                {line.modifiers.map((m: string) => (
                  <span class="inline-flex items-center rounded-md bg-[#f0f2f5] dark:bg-[#20252f] px-2 py-0.5 text-[9px] font-medium text-[#5d6675] dark:text-[#9aa4b5]">
                    {m}
                  </span>
                ))}
              </div>
            )}
            {line.note && (
              <div class="text-[10px] text-[#5d6675] dark:text-[#9aa4b5] mt-1.5">یادداشت: {line.note}</div>
            )}
          </div>
        ))
      }
    </div>

    <!-- Totals: جمع جزء / ارزش افزوده (٪) / قابل پرداخت -->
    <div class="px-4 py-3 border-t border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923] space-y-1.5">
      <div class="flex items-center justify-between text-[11px]">
        <span class="text-[#5d6675] dark:text-[#9aa4b5]">جمع جزء</span>
        <span class="text-[#1a1d24] dark:text-[#e8ebf1] tabular-nums">{formatToman(subtotal)}</span>
      </div>
      <div class="flex items-center justify-between text-[11px]">
        <span class="text-[#5d6675] dark:text-[#9aa4b5]">ارزش افزوده ({fa(10)}٪)</span>
        <span class="text-[#1a1d24] dark:text-[#e8ebf1] tabular-nums">{formatToman(vatTotal)}</span>
      </div>
      <div class="flex items-center justify-between border-t border-[#e2e5ea]/70 dark:border-[#272d39]/70 pt-2">
        <span class="text-[14px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">قابل پرداخت</span>
        <span class="text-[16px] font-black text-[#C41E3A] tabular-nums">
          {formatToman(grandTotal)}
        </span>
      </div>
      <div class="grid grid-cols-2 gap-2 pt-2">
        <span class="text-center px-3 py-2 rounded-xl text-[11px] font-semibold border border-[#e2e5ea] dark:border-[#272d39] text-[#1a1d24] dark:text-[#e8ebf1]">
          ثبت موقت
        </span>
        <span class="text-center px-3 py-2 rounded-xl text-[11px] font-semibold text-[#c02f2f] dark:text-[#f06a70]">
          حذف نیمه‌کاره
        </span>
        <span class="col-span-2 text-center px-3 py-3 rounded-xl text-[12px] font-bold bg-[#C41E3A] text-white">
          تسویه و پرداخت
        </span>
        <span class="col-span-2 text-center text-[10px] text-[#5d6675] dark:text-[#9aa4b5]">
          ارسال به بار/آشپزخانه از همین سبد انجام می‌شود
        </span>
      </div>
      <div class="flex items-center justify-center gap-1.5 pt-1">
        <Wifi class="w-3 h-3 text-emerald-500" aria-hidden="true" />
        <span class="text-[9px] text-[#5d6675] dark:text-[#9aa4b5]">اتصال پرینتر و کارتخوان برقرار است</span>
      </div>
    </div>
  </aside>
</div>
