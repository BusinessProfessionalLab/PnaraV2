---
/**
 * Reports dashboard mockup (`/admin/reports`).
 *
 * Uses the same blocks the real reports screen renders in
 * `frontend/src/components/admin/reports-hub.tsx`: preset switcher
 * (`امروز / دیروز / این ماه / ماه قبل / بازه دلخواه` + `ساعتی / روزانه /
 * هفتگی`), KPI row (فروش / تخفیف‌ها / ارزش افزوده), hourly peak-hours heat
 * strip, revenue share per category, best-vs-worst list, profit-margin /
 * COGS band (`بهای تمام‌شده / حاشیه سود`), payment + terminal breakdown,
 * cashier audit, customer return-rate, and stock alerts.
 */
import { CalendarRange, Clock3, Crown, TrendingUp, Users, Wallet, RotateCcw, TriangleAlert } from "@lucide/astro";
import { formatToman, fa, faPercent } from "@/lib/fa";

// Hour → relative sales intensity for a café day (opening spike, lunch, evening peak).
const hourly = [
  4, 2, 2, 2, 3, 6, 14, 26, 42, 56, 64, 58, 52, 60, 66, 54, 60, 72, 84, 96, 88, 74, 48, 20,
];

const categoryShares = [
  { name: "قهوه گرم", share: 38, color: "#C41E3A" },
  { name: "قهوه سرد", share: 27, color: "#3f5d87" },
  { name: "کیک و دسر", share: 18, color: "#b06b1f" },
  { name: "صبحانه", share: 11, color: "#2e7d5b" },
  { name: "دمنوش", share: 6, color: "#8c9bab" },
];

// Build the donut out of a single conic-gradient — no chart library needed.
let cursor = 0;
const donut = categoryShares
  .map((c) => {
    const from = cursor;
    cursor += c.share;
    return `${c.color} ${from}% ${cursor}%`;
  })
  .join(", ");

const topItems = [
  { title: "لاته", category: "قهوه گرم", qty: 412, rial: 49_440_000, band: "Star" },
  { title: "آیس لاته", category: "قهوه سرد", qty: 286, rial: 41_470_000, band: "Star" },
  { title: "کیک شکلاتی", category: "کیک و دسر", qty: 154, rial: 18_480_000, band: "default" },
  { title: "چای ماسالا", category: "دمنوش", qty: 21, rial: 1_995_000, band: "Underperforming" },
];

const cashiers = [
  { name: "مریم رضایی", orders: 96, rial: 78_400_000, avgRial: 816_000 },
  { name: "علی کاظمی", orders: 61, rial: 48_900_000, avgRial: 801_000 },
];

const kpis = [
  { label: "فروش", value: 111_385_000 },
  { label: "تخفیف‌ها", value: 3_200_000 },
  { label: "ارزش افزوده", value: 10_450_000 },
];

const totalSales = topItems.reduce((s, i) => s + i.rial, 0);
---

<div class="flex flex-col bg-[#f7f8fa] dark:bg-[#0e1117]">
  <!-- Presets + interval + period value -->
  <div class="flex flex-wrap items-center gap-2 px-4 py-3 border-b border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
    <div class="flex gap-0.5 rounded-xl bg-[#f0f2f5] dark:bg-[#20252f] p-1 overflow-x-auto">
      {["امروز", "این ماه", "بازه دلخواه"].map((label, i) => (
        <span
          class:list={[
            "px-3 py-1.5 rounded-lg text-[11px] font-semibold whitespace-nowrap",
            i === 1
              ? "bg-white dark:bg-[#151923] text-[#1a1d24] dark:text-[#e8ebf1] shadow-sm"
              : "text-[#5d6675] dark:text-[#9aa4b5]",
          ]}
        >
          {label}
        </span>
      ))}
    </div>
    <div class="flex gap-0.5 rounded-xl bg-[#f0f2f5] dark:bg-[#20252f] p-1">
      {["روزانه", "هفتگی"].map((label, i) => (
        <span
          class:list={[
            "px-2.5 py-1 rounded-lg text-[10px] font-medium whitespace-nowrap",
            i === 0
              ? "bg-white dark:bg-[#151923] text-[#1a1d24] dark:text-[#e8ebf1] shadow-sm"
              : "text-[#5d6675] dark:text-[#9aa4b5]",
          ]}
        >
          {label}
        </span>
      ))}
    </div>
    <div class="flex items-center gap-1.5 ms-auto text-[11px] text-[#5d6675] dark:text-[#9aa4b5]">
      <CalendarRange class="w-3.5 h-3.5" aria-hidden="true" />
      <span class="tabular-nums">{formatToman(totalSales)} فروش در این بازه</span>
    </div>
  </div>

  <!-- KPI row: فروش / تخفیف‌ها / ارزش افزوده -->
  <div class="grid grid-cols-3 gap-2 px-4 py-3 border-b border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
    {
      kpis.map((k) => (
        <div class="rounded-xl border border-[#e2e5ea] dark:border-[#272d39] bg-[#f7f8fa] dark:bg-[#0e1117] px-3 py-2">
          <div class="text-[10px] text-[#5d6675] dark:text-[#9aa4b5]">{k.label}</div>
          <div class="mt-0.5 text-[12px] font-black text-[#1a1d24] dark:text-[#e8ebf1] tabular-nums truncate">{formatToman(k.value)}</div>
        </div>
      ))
    }
  </div>

  <!-- Peak hours heat strip -->
  <div class="px-4 py-4 border-b border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
    <div class="flex items-center gap-2 mb-3">
      <Clock3 class="w-3.5 h-3.5 text-[#C41E3A]" aria-hidden="true" />
      <span class="text-[12px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">ساعات پیک فروش</span>
    </div>
    <div class="flex items-end gap-[3px] h-20">
      {
        hourly.map((v, hour) => (
          <div class="group relative flex-1 h-full flex items-end" title={`ساعت ${fa(hour)}`}>
            <div
              class="w-full rounded-sm bg-[#C41E3A] transition-opacity"
              style={`height: ${Math.max(4, v)}%; opacity: ${(0.18 + (v / 96) * 0.72).toFixed(2)};`}
            />
          </div>
        ))
      }
    </div>
    <div class="flex gap-[3px] mt-1.5">
      {
        hourly.map((_, hour) => (
          <div class="flex-1 text-center text-[8px] leading-3 text-[#5d6675] dark:text-[#9aa4b5] tabular-nums">
            {hour % 3 === 0 ? fa(hour) : ""}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Category share + best/worst -->
  <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x sm:divide-x-reverse divide-[#e2e5ea] dark:divide-[#272d39] bg-white dark:bg-[#151923] [&>div]:px-4 [&>div]:py-4">
    <div>
      <div class="flex items-center gap-2 mb-3">
        <TrendingUp class="w-3.5 h-3.5 text-[#C41E3A]" aria-hidden="true" />
        <span class="text-[12px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">توزیع درآمد دسته‌ها</span>
      </div>
      <div class="flex items-center gap-4">
        <div class="relative w-20 h-20 shrink-0" role="img" aria-label="سهم دسته‌ها از درآمد">
          <div class="w-full h-full rounded-full" style={`background: conic-gradient(${donut});`}></div>
          <div class="absolute inset-[22%] rounded-full bg-white dark:bg-[#151923]"></div>
        </div>
        <ul class="min-w-0 flex-1 space-y-1">
          {
            categoryShares.map((c) => (
              <li class="flex items-center gap-1.5 text-[10px]">
                <span class="w-2 h-2 rounded-full shrink-0" style={`background: ${c.color};`} />
                <span class="text-[#1a1d24] dark:text-[#e8ebf1] truncate">{c.name}</span>
                <span class="ms-auto text-[#5d6675] dark:text-[#9aa4b5] tabular-nums">{faPercent(c.share)}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div>
      <div class="flex items-center gap-2 mb-3">
        <Crown class="w-3.5 h-3.5 text-[#C41E3A]" aria-hidden="true" />
        <span class="text-[12px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">پرفروش در برابر کم‌فروش</span>
      </div>
      <ul class="space-y-2.5">
        {
          topItems.map((item) => (
            <li>
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-semibold text-[#1a1d24] dark:text-[#e8ebf1] truncate">
                  {item.title}
                </span>
                {item.band === "Star" && (
                  <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 border border-emerald-600/20">
                    پرفروش
                  </span>
                )}
                {item.band === "Underperforming" && (
                  <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#f0f2f5] text-[#5d6675] dark:bg-[#20252f] dark:text-[#9aa4b5]">
                    کم‌فروش
                  </span>
                )}
                <span class="ms-auto text-[10px] text-[#5d6675] dark:text-[#9aa4b5] tabular-nums">
                  {formatToman(item.rial)}
                </span>
              </div>
              <div class="mt-1.5 h-1.5 rounded-full bg-[#f0f2f5] dark:bg-[#20252f] overflow-hidden">
                <div
                  class:list={[
                    "h-full rounded-full",
                    item.band === "Star"
                      ? "bg-[#C41E3A]"
                      : item.band === "Underperforming"
                        ? "bg-[#cdd3db] dark:bg-[#3b4353]"
                        : "bg-[#C41E3A]/45",
                  ]}
                  style={`width: ${((item.rial / topItems[0].rial) * 100).toFixed(1)}%;`}
                />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Profit margin / COGS -->
  <div class="px-4 py-4 border-t border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <TrendingUp class="w-3.5 h-3.5 text-[#C41E3A]" aria-hidden="true" />
      <span class="text-[12px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">حاشیه سود · بهای تمام‌شده</span>
      <span class="ms-auto px-2 py-0.5 rounded-md text-[10px] font-semibold bg-amber-400/15 text-amber-800 dark:text-amber-300 border border-amber-400/25 tabular-nums">
        بهای تمام‌شده {formatToman(38_400_000)}
      </span>
    </div>
    <div class="rounded-xl border border-[#e2e5ea] dark:border-[#272d39] bg-[#f7f8fa] dark:bg-[#0e1117] px-3 py-2.5 text-[11px] text-[#5d6675] dark:text-[#9aa4b5] leading-6">
      حاشیه سود هر آیتم و هر دسته از بهای میانگین موزون انبار حساب می‌شود — نه از آخرین خرید. همین عدد در گزارش سود مبنای تصمیم حذف یا نگه‌داشتن آیتم است.
    </div>
  </div>

  <!-- Payments + terminals -->
  <div class="px-4 py-4 border-t border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
    <div class="flex items-center gap-2 mb-3">
      <Wallet class="w-3.5 h-3.5 text-[#C41E3A]" aria-hidden="true" />
      <span class="text-[12px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">تفکیک پرداخت و ترمینال‌ها</span>
    </div>
    <div class="flex flex-wrap gap-1.5 text-[10px]">
      <span class="px-2 py-1 rounded-md font-semibold bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 tabular-nums">نقدی · {formatToman(42_000_000)}</span>
      <span class="px-2 py-1 rounded-md font-semibold bg-blue-600/10 text-blue-700 dark:text-blue-400 tabular-nums">کارتخوان · {formatToman(58_300_000)}</span>
      <span class="px-2 py-1 rounded-md font-semibold bg-amber-400/15 text-amber-800 dark:text-amber-300 tabular-nums">کارت به کارت · {formatToman(11_085_000)}</span>
    </div>
    <div class="mt-2 text-[10px] text-[#5d6675] dark:text-[#9aa4b5] leading-6">
      گزارش Z شیفت، فروش هر شیفت را بر اساس روش پرداخت می‌بندد. ابطال و استرداد پرداخت هم با مرجع ثبت می‌شود.
    </div>
  </div>

  <!-- Cashier audit -->
  <div class="px-4 py-4 border-t border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
    <div class="flex items-center gap-2 mb-3">
      <Users class="w-3.5 h-3.5 text-[#C41E3A]" aria-hidden="true" />
      <span class="text-[12px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">ممیزی عملکرد صندوق‌دار</span>
    </div>
    <ul class="divide-y divide-dashed divide-[#e2e5ea] dark:divide-[#272d39]">
      {
        cashiers.map((c) => (
          <li class="flex items-center gap-3 py-2">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#f0f2f5] dark:bg-[#20252f] text-[10px] font-bold text-[#5d6675] dark:text-[#9aa4b5]">
              {c.name.slice(0, 1)}
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[11px] font-semibold text-[#1a1d24] dark:text-[#e8ebf1] truncate">{c.name}</div>
              <div class="text-[10px] text-[#5d6675] dark:text-[#9aa4b5] tabular-nums">
                {fa(c.orders)} سفارش
              </div>
            </div>
            <div class="text-end">
              <div class="text-[11px] font-bold text-[#1a1d24] dark:text-[#e8ebf1] tabular-nums">
                {formatToman(c.rial)}
              </div>
              <div class="text-[10px] text-[#5d6675] dark:text-[#9aa4b5] tabular-nums">
                میانگین {formatToman(c.avgRial)}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Return rate + stock alerts -->
  <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x sm:divide-x-reverse divide-[#e2e5ea] dark:divide-[#272d39] border-t border-[#e2e5ea] dark:border-[#272d39] bg-white dark:bg-[#151923]">
    <div class="px-4 py-4">
      <div class="flex items-center gap-2 mb-2">
        <RotateCcw class="w-3.5 h-3.5 text-[#C41E3A]" aria-hidden="true" />
        <span class="text-[12px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">نرخ بازگشت مشتری‌ها</span>
      </div>
      <div class="text-[11px] text-[#5d6675] dark:text-[#9aa4b5] leading-6">
        چند درصد مشتری‌ها بیش از یک‌بار برگشته‌اند — خروجی مستقیم باشگاه مشتریان.
      </div>
      <div class="mt-2 text-[16px] font-black text-emerald-700 dark:text-emerald-400 tabular-nums">{faPercent(34)}</div>
    </div>
    <div class="px-4 py-4">
      <div class="flex items-center gap-2 mb-2">
        <TriangleAlert class="w-3.5 h-3.5 text-[#C41E3A]" aria-hidden="true" />
        <span class="text-[12px] font-bold text-[#1a1d24] dark:text-[#e8ebf1]">هشدارهای موجودی</span>
      </div>
      <div class="text-[11px] text-[#5d6675] dark:text-[#9aa4b5] leading-6 tabular-nums">
        {fa(2)} کالا زیر نقطه سفارش — همان هشداری که روی کارت محصول در صندوق هم می‌آید.
      </div>
    </div>
  </div>
</div>
