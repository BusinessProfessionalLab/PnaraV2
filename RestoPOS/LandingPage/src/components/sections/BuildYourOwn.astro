---
import Button from '../Button.astro';
---
<section class="byo">
  <div class="byo__text">
    <p class="badge">Build your own</p>
    <h2 class="h2">Don't see what you need? Describe it. <em>Parley drafts it.</em></h2>
    <p class="byo__lede">
      Tell Parley what you do today — out loud, in plain words. It will draft a
      workflow with steps, triggers, and integrations for you to review before
      anything runs.
    </p>
    <Button href="/contact" label="Start from scratch" variant="primary" />
  </div>
  <div class="byo__media">
    <img src="/assets/wf-describe.webp" alt="Support chat interface with user and agent conversation" loading="lazy" />
  </div>
</section>
