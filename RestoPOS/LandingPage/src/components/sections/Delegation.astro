---
import { group, type Feature } from '../../lib/content';
const features = await group<Feature>('features');
---
<!-- Sections/Tab+image. The Framer component is a plain relative section with
     click-driven tab variants; it does not pin or advance on scroll. -->
<section class="delegation" id="delegation">
  <header class="delegation__header">
    <div class="delegation__heading">
      <p class="badge">Intelligent Delegation</p>
      <h2 class="h2">Tell Parley once.<br /><em>It handles the rest.</em></h2>
    </div>
    <p class="delegation__lede">
      Describe a goal in plain language and Parley breaks it into steps,
      selects the right tools, and executes &#8212; keeping you updated
      along the way.
    </p>
  </header>

  <div class="delegation__inner">
    <ol class="features" role="tablist" aria-label="Delegation features">
      {features.map((f) => (
        <li class="feature" style={`--i:${f.step}`}>
          <button
            class="feature__btn"
            type="button"
            role="tab"
            id={`feature-${f.step}`}
            data-step={f.step}
            aria-selected={f.step === 0 ? 'true' : 'false'}
            aria-controls={`mock-${f.step}`}
            tabindex={f.step === 0 ? 0 : -1}
          >
            <img class="feature__chevron" src="/assets/arrows.svg" alt="" aria-hidden="true" />
            <span class="feature__head">
              <h4 class="feature__label">{f.label}</h4>
              <span class="feature__desc">{f.desc}</span>
            </span>
          </button>
        </li>
      ))}
    </ol>

    <div class="stage">
      {features.map((f) => (
        <div
          class={`mock${f.step === 0 ? ' is-active' : ''}`}
          id={`mock-${f.step}`}
          role="tabpanel"
          aria-labelledby={`feature-${f.step}`}
          data-step={f.step}
          hidden={f.step !== 0}
        >
          <img class="mock__img" src={f.mock} srcset={f.srcset} alt="" width={f.w} height={f.h} loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>
</section>
