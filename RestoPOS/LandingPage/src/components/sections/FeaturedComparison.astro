---
import Button from '../Button.astro';

/** "Lead enrichment, before and after" — two stacked stat tables, the left
 *  one on the warm surface, the right one bare. */
const rows = [
  { label: 'Time per Lead', parley: '~40 sec', manual: '~18 min' },
  { label: 'Tools touched', parley: '1 trigger', manual: '14' },
  { label: 'Audit trail', parley: 'Full', manual: 'None' },
  { label: 'Scales to nights & weekends', parley: 'Yes', manual: 'No' },
];
---
<section class="fcomp">
  <header class="fcomp__header">
    <div class="fcomp__heading">
      <p class="badge">Featured Workflow</p>
      <h2 class="h2">Lead enrichment,<br /><em>before and after.</em></h2>
    </div>
    <div class="fcomp__side">
      <p class="fcomp__lede">
        The same job, run by a human or run by Parley. Same output, very
        different math
      </p>
      <Button href="/workflow-1" label="Open this workflow" variant="primary" />
    </div>
  </header>

  <div class="fcomp__cols">
    <div class="fcol fcol--parley">
      <h5 class="fcol__title">With Parley</h5>
      <p class="fcol__sub">One workflow, one trigger</p>
      <dl class="fcol__rows">
        {rows.map((r) => (
          <div class="fcol__row"><dt>{r.label}</dt><dd><h5>{r.parley}</h5></dd></div>
        ))}
      </dl>
    </div>
    <div class="fcol fcol--manual">
      <h5 class="fcol__title">Manual</h5>
      <p class="fcol__sub">One specialist + 14 browser tabs</p>
      <dl class="fcol__rows">
        {rows.map((r) => (
          <div class="fcol__row"><dt>{r.label}</dt><dd><h5>{r.manual}</h5></dd></div>
        ))}
      </dl>
    </div>
  </div>

  <img class="fcomp__mosaic" src="/assets/wf-mosaic.webp" alt="" loading="lazy" />
</section>
