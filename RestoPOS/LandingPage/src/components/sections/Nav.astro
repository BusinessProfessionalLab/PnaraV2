---
import Button from "../Button.astro";
import { group, type Link } from "../../lib/content";
const links = await group<Link>("navLinks");
---

<header class="nav-bar" data-nav>
  <nav class="nav" aria-label="Main">
    <div class="nav__right" id="nav-menu" data-nav-menu>
      <ul class="nav__links">
        {
          links.map((l, i) => (
            <>
              {i > 0 && <li aria-hidden="true" class="nav__sep" />}
              <li
                class={
                  l.dropdown ? "nav__item nav__item--has-menu" : "nav__item"
                }
              >
                <a
                  href={l.href}
                  aria-haspopup={l.dropdown ? "true" : undefined}
                >
                  {l.label}
                </a>
                {l.dropdown && (
                  <div
                    class="nav__drop"
                    role="group"
                    aria-label={`${l.label} links`}
                  >
                    {l.dropdown.map((s) => (
                      <a class="nav__dropitem" href={s.href}>
                        <span class="nav__dropdot" aria-hidden="true" />
                        {s.label}
                      </a>
                    ))}
                  </div>
                )}
              </li>
            </>
          ))
        }
      </ul>
    </div>
    <a href="/" class="nav__brand" aria-label="Parley">
      <img src="/assets/PnaraLogo.svg" alt="Parley" width="78" height="26" />
    </a>
  </nav>
</header>
