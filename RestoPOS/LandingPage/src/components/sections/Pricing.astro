---
import Button from '../Button.astro';
import { group, type Plan } from '../../lib/content';
const plans = await group<Plan>('plans');
/** The pricing page promotes this heading to the page h1. */
const { headingLevel = 2, display = false } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
---
<section class="pricing" id="pricing">
  <header class="pricing__header">
    <div class="pricing__heading">
      <p class="badge">Pricing</p>
      <Heading class={display ? 'ts-display' : 'h2'}>
        Simple, transparent pricing. <em>No surprises.</em>
      </Heading>
    </div>
    <div class="pricing__side">
      <p class="pricing__lede">
        Start free, scale as you grow. Every plan includes core features —
        upgrade when you need more power or seats.
      </p>
    </div>
  </header>

  <div class="pricing__billing">
    <div class="toggle" role="tablist" aria-label="Billing period">
      <button class="toggle__btn is-active" type="button" role="tab" aria-selected="true">Monthly</button>
      <button class="toggle__btn" type="button" role="tab" aria-selected="false">
        Annual <span class="toggle__off">-15%</span>
      </button>
    </div>
  </div>

  <div class="plans" id="plans">
    {plans.map((plan) => (
      <article class={`plan${plan.featured ? ' is-featured' : ''}`} data-index={plan.index}>
        <h4 class="plan__name">{plan.name}</h4>
        <div class="plan__pricing">
          <h3 class="plan__price">
            <span class="plan__currency">{plan.currency}</span><span class="plan__amount">{plan.amount}</span>
          </h3>
          <p class="plan__period">{plan.period}</p>
        </div>
        <p class="plan__desc">{plan.desc}</p>
        <ul class="plan-features">
          {plan.features.map((f) => (
            <li class={f.off ? 'is-off' : undefined}><span class="plan-features__dot"></span>{f.text}</li>
          ))}
        </ul>
        <Button href={plan.cta.href} label={plan.cta.label} variant={plan.cta.variant} full />
      </article>
    ))}
  </div>
</section>
