---
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import StoreBadge from '../components/StoreBadge.astro';
import Head from './Head.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import Cta from '../components/sections/Cta.astro';
// Fonts ship with the site (no request to Google): DM Sans with its optical-size axis, upright and italic, and Geist.
import '@fontsource-variable/dm-sans/opsz.css';
import '@fontsource-variable/dm-sans/opsz-italic.css';
import '@fontsource-variable/geist';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  schema?: boolean;
  /** Closing CTA panel. Framer shows it on every route except /404 and the
   *  blog articles, which end on their own related-posts strip. */
  cta?: boolean;
}
const { title, description, path, cta = true, ogImage, schema } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head><Head title={title} description={description} path={path} ogImage={ogImage} schema={schema} /></head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" class="page" data-page={path}>
      <div class="container">
        <slot />
        {cta && <Cta />}
      </div>
      <Footer />
    </main>
    <script>
      import '../scripts/entry.js';
    </script>
    {import.meta.env.PUBLIC_VERCEL_ANALYTICS && <Analytics />}
    {import.meta.env.PUBLIC_VERCEL_ANALYTICS && <SpeedInsights />}
    <StoreBadge />
    <GoogleAnalytics />
  </body>
</html>
