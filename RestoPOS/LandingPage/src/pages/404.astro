---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base
  title="Page Not Found | Parley"
  description="The requested page could not be found on the Parley AI agent Astro template site."
  path="/404"
  cta={false}
>
  <section class="nf">
    <img class="nf__mosaic" src="/assets/404-mosaic.webp" alt="" loading="lazy" />
    <p class="nf__code" aria-hidden="true">404</p>
    <h1 class="nf__title">Oops! The page you’re looking for can’t be found.</h1>
    <Button href="/" label="Go to Home page" variant="primary" />
  </section>
</Base>
