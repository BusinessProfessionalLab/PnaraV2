---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Logos from '../components/sections/Logos.astro';
import { group, type Workflow, type Logo } from '../lib/content';

export async function getStaticPaths() {
  const { group } = await import('../lib/content');
  const workflows = await group<Workflow>('workflows');
  return workflows.map((w) => ({ params: { workflow: w.slug }, props: { w } }));
}

const { w } = Astro.props as { w: Workflow };
const meta: Record<string, { title: string; desc: string }> = {
  'workflow-1': {
    title: 'Workflow Detail Page Template | Parley',
    desc: 'A detailed workflow page for presenting AI agent use cases and automation flows in the Parley Astro template.',
  },
  'workflow-2': {
    title: 'AI Workflow Use Case Template | Parley',
    desc: 'A workflow detail page template for AI agent use cases, automation stories, and SaaS product pages.',
  },
  'workflow-3': {
    title: 'Automation Workflow Page Template | Parley',
    desc: 'A polished workflow page for AI automation products and agentic SaaS templates built with Astro.',
  },
};
const m = meta[w.slug];
const logos = await group<Logo>('logos');
const brandLogo = logos.find((l) => l.slug === w.brand.toLowerCase());

---
<Base title={m.title} description={m.desc} path={`/${w.slug}`}>
  <header class="wdhero">
    <p class="badge">{w.category}</p>
    <h1 class="wdhero__title">{w.title}</h1>
    <p class="wdhero__lede">{w.lede}</p>
    <div class="wdhero__actions">
      <Button href="/contact" label="Try this workflow" variant="primary" />
      <p class="wdhero__by">
        Created by
        <span class="wdhero__chip">
          <img src="/assets/parley-logo.webp" alt="" width="52" height="17" />
        </span>
        Parley Team
      </p>
    </div>
  </header>

  <div class="wdshot"><img src={w.hero} alt={w.heroAlt} /></div>

  <section class="wdprod">
    <header class="wdprod__header">
      <div class="wdprod__heading">
        <p class="badge">The product</p>
        <h2 class="h2">{w.sectionTitle}<br /><em>{w.sectionTitleEm}</em></h2>
      </div>
      <p class="wdprod__lede">{w.sectionLede}</p>
    </header>

    <div class="wdwide">
      <div class="wdwide__text">
        <span class="wdwide__dots" aria-hidden="true"><i></i></span>
        <h5 class="wdwide__title">{w.wide.title}</h5>
        <p class="wdwide__desc">{w.wide.desc}</p>
      </div>
      <div class="wdwide__media"><img src={w.wide.image} alt={w.wide.alt} loading="lazy" /></div>
    </div>

    <ul class="wdfeat" role="list">
      {w.features.map((f) => (
        <li class="wdfeat__item">
          <span class="wdwide__dots" aria-hidden="true">
            {Array.from({ length: f.dots }, () => <i></i>)}
          </span>
          <h5 class="wdfeat__title">{f.title}</h5>
          <p class="wdfeat__desc">{f.desc}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wdproof">
    <p class="badge badge--center">In Production</p>
    <h2 class="h2 h2--center">{w.proofTitle}</h2>

    <figure class="wdquote">
      <div class="wdquote__card">
      <div class="wdquote__main">
        <span class="wdquote__brand">
          {brandLogo
            ? brandLogo.parts.map((p) => (
                <img class="wdquote__brandpart" src={p.d} alt={w.brand} style={`--w:${p.w}px;--h:${p.h}px`} />
              ))
            : w.brand}
        </span>
        <blockquote class="wdquote__text">{w.quote}</blockquote>
        <figcaption class="wdquote__author">
          <img src={w.avatar} alt="" width="36" height="36" />
          <span>
            <h5 class="wdquote__name">{w.name}</h5>
            <span class="wdquote__role">{w.role}</span>
          </span>
        </figcaption>
      </div>
      <div class="wdquote__stat">
        <h3 class="wdquote__value">{w.stat}</h3>
        <p class="wdquote__label">{w.statLabel}</p>
      </div>
      </div>
    </figure>
  </section>

  <div class="wdlogos"><Logos hideLabel /></div>
</Base>
