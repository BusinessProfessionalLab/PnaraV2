---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { getCollection, render } from "astro:content";
import {
  Sparkles, TrendingUp, Bug, Zap, ShieldCheck, ArrowLeft
} from "@lucide/astro";
import { siteConfig } from "@/config/site";

const entries = (await getCollection("changelog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

/** Change categories, matching the labels the in-app version page uses. */
const CHANGE_META = {
  feature: { label: "قابلیت جدید", icon: Sparkles, cls: "bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light" },
  improvement: { label: "بهبود", icon: TrendingUp, cls: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400" },
  bugfix: { label: "رفع اشکال", icon: Bug, cls: "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300" },
  performance: { label: "کارایی", icon: Zap, cls: "bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300" },
  security: { label: "امنیت", icon: ShieldCheck, cls: "bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300" },
} as const;

const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<Layout
  title="تغییرات نسخه‌ها — پینارا"
  description="تاریخچه نسخه‌های پینارا: قابلیت‌های جدید، بهبودها و رفع اشکال‌ها — همان تغییراتی که در صندوق و پنل مدیریت کافه دیده می‌شود."
  keywords="تغییرات نسخه پینارا, نسخه‌های صندوق کافه, به‌روزرسانی نرم‌افزار کافه"
>
  <section class="site-container my-12">
    <PageHeader
      title="تغییرات نسخه‌ها"
      description={`نسخه فعلی ${siteConfig.product.version} است. هر نسخه را با همان دسته‌بندی‌ای منتشر می‌کنیم که در پنل مدیریت می‌بینید.`}
    />
  </section>

  <section class="site-container max-w-3xl mx-auto pb-16">
    <div class="relative">
      <div class="absolute top-2 bottom-2 end-[7px] w-px bg-neutral-200 dark:bg-neutral-700"></div>

      <div class="space-y-12">
        {rendered.map(({ entry, Content }, i) => (
          <article
            class="relative pe-10"
            data-aos="fade-up-sm"
            data-aos-delay={i * 80}
            data-aos-once="true"
          >
            <div class="absolute end-0 top-1.5 w-4 h-4 rounded-full bg-primary border-2 border-bg-primary dark:border-bg-primary-dark"></div>

            <div class="mb-2 flex items-center gap-3 flex-wrap">
              {entry.data.version && <Badge variant="primary" size="sm">{entry.data.version}</Badge>}
              <time class="text-sm text-neutral-400 dark:text-neutral-500 tabular-nums" datetime={entry.data.publishDate.toISOString()}>
                {entry.data.dateLabel ?? entry.data.publishDate.toISOString().slice(0, 10)}
              </time>
            </div>

            <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-100 mb-2">{entry.data.title}</h2>

            {entry.data.description && (
              <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-7 mb-5">{entry.data.description}</p>
            )}

            {entry.data.changes && (
              <ul class="space-y-3 mb-5">
                {entry.data.changes.map((change) => {
                  const meta = CHANGE_META[change.type];
                  return (
                    <li class="rounded-xl border border-primary/10 dark:border-neutral-700 bg-bg-secondary/60 dark:bg-bg-secondary-dark/60 p-4">
                      <div class="flex flex-wrap items-center gap-2 mb-1.5">
                        <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-medium ${meta.cls}`}>
                          <meta.icon class="w-3 h-3" aria-hidden="true" />
                          {meta.label}
                        </span>
                        <span class="text-sm font-bold text-neutral-800 dark:text-neutral-100">{change.title}</span>
                      </div>
                      {change.description && (
                        <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-6">{change.description}</p>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}

            <div class="changelog-content text-sm text-neutral-600 dark:text-neutral-300 leading-7">
              <Content />
            </div>
          </article>
        ))}

        {entries.length === 0 && (
          <p class="text-center text-neutral-400 dark:text-neutral-500 py-12">هنوز نسخه‌ای منتشر نشده است.</p>
        )}
      </div>
    </div>

    <div class="mt-14 text-center">
      <Button url="/contact" type="fill" size="lg">
        درخواست دمو <ArrowLeft size={18} />
      </Button>
    </div>
  </section>
</Layout>

<style>
  .changelog-content :global(p) {
    margin-bottom: 0.5rem;
  }
</style>
