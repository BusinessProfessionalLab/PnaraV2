---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactMethods from '../components/sections/ContactMethods.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import Faq from '../components/sections/Faq.astro';
---
<Base
  title="Contact Page Template for AI Startups | Parley"
  description="A polished contact page layout for AI agent startups and SaaS products, included with the Parley Astro template."
  path="/contact"
>
  <PageHero
    badge="Contact us"
    center
    display
    lede="Book a demo, ask a question, or send a hard problem. A human responds — most under four hours, never longer than one business day."
  >
    <span class="ts-display--soft">Let’s talk —</span>
    <p slot="after-title" class="ts-display phero__title2">about the work<br />nobody wants to do</p>
  </PageHero>

  <section class="contact">
    <ContactMethods />
    <ContactForm />
  </section>

  <Faq />
</Base>
