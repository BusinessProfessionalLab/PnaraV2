---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Logos from '../components/sections/Logos.astro';
import Why from '../components/sections/Why.astro';
import Delegation from '../components/sections/Delegation.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Pricing from '../components/sections/Pricing.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Faq from '../components/sections/Faq.astro';
import Integrations from '../components/sections/Integrations.astro';
---
<Base
  title="Parley - AI Agent Astro Template for SaaS Startups"
  description="Launch an AI agent or automation startup site with Parley, a polished Astro template with product sections, workflows, pricing, blog pages, and conversion-ready layouts."
  path="/"
>
  <Hero />
  <Logos />
  <Why />
  <Delegation />
  <Testimonials />
  <Pricing />
  <HowItWorks />
  <Faq />
  <Integrations />
</Base>
