---
import Bare from '../layouts/Bare.astro';

/** Waitlist / contact success page. Shares the waitlist split layout;
 *  nothing links to it — it is the forms' success destination. */
const socials = [
  { href: 'https://x.com', label: 'X', path: 'M17.53 3h3.18l-6.95 7.94L22 21h-6.41l-5.02-6.56L4.83 21H1.65l7.43-8.49L1.5 3h6.57l4.54 6.01zM16.4 19h1.76L7.69 4.9H5.81z' },
  { href: 'https://www.threads.com', label: 'Threads', path: 'M12.7 11.2c-.1-1.9-1.1-3-2.8-3-1 0-1.9.4-2.4 1.2l-1.3-.9c.8-1.2 2.1-1.8 3.7-1.8 2.6 0 4.3 1.7 4.4 4.4.3.1.6.3.9.5 1.2.8 1.8 2 1.8 3.4 0 2.6-2.1 4.3-5.1 4.3-3.6 0-6.3-2.5-6.3-7s2.7-7 6.3-7c2 0 3.6.7 4.7 2.1l-1.2 1c-.8-1.1-2-1.6-3.5-1.6-2.7 0-4.6 1.9-4.6 5.5s1.9 5.5 4.6 5.5c2 0 3.4-1 3.4-2.7 0-.9-.4-1.6-1.1-2 0 1.9-1.2 3.1-3 3.1-1.6 0-2.8-1-2.8-2.5s1.2-2.6 3.1-2.6c.4 0 .8 0 1.2.1zm-1.3 1.4c-.3-.1-.7-.1-1-.1-1 0-1.6.4-1.6 1.1s.5 1 1.3 1c1 0 1.4-.7 1.3-2z' },
  { href: 'https://www.linkedin.com', label: 'LinkedIn', path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57zM22.22 0H1.77C.8 0 0 .78 0 1.74v20.52C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0z' },
];
---
<Bare
  title="Thank You Page Template | Parley AI Agent Astro Template"
  description="A simple confirmation page for signups, demos, and waitlist flows in the Parley AI agent Astro template."
  path="/thank-you"
  schema={false}
>
  <div class="wl">
    <div class="wl__left">
      <a class="wl__brand" href="/" aria-label="Parley">
        <img src="/assets/parley-logo.webp" alt="Parley" width="78" height="26" />
      </a>

      <div class="wl__main">
        <h1 class="wl__title">Thank you<br />so much!</h1>
        <p class="wl__lede">You're now on the waitlist! Stay tuned for updates.</p>
        <ul class="ty__socials" role="list">
          {socials.map((s) => (
            <li>
              <a class="footer__social-btn" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={s.path} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <footer class="wl__footer">
        <p>© 2026 Parley. For AI agent template</p>
        <p><a href="/terms-conditions">Terms&amp;Conditions</a></p>
      </footer>
    </div>

    <div class="wl__right">
      <img src="/assets/waitlist-app.webp" alt="Parley AI agent Astro template interface preview" />
    </div>
  </div>
</Bare>
