---
import Bare from '../layouts/Bare.astro';
const avatars = [
  '/assets/waitlist-avatar-1.webp',
  '/assets/waitlist-avatar-2.webp',
  '/assets/waitlist-avatar-3.webp',
];
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---
<Bare
  title="AI Startup Waitlist Page Template | Parley"
  description="A focused waitlist page for AI agents, SaaS launches, and automation products, included with the Parley Astro template."
  path="/waitlist"
  schema={false}
>
  <div class="wl">
    <div class="wl__left">
      <a class="wl__brand" href="/" aria-label="Parley">
        <img src="/assets/parley-logo.webp" alt="Parley" width="78" height="26" />
      </a>

      <div class="wl__main">
        <p class="wl__launch">Launches: Oct 25, 2026</p>
        <h1 class="wl__title">Get early access</h1>
        <p class="wl__lede">Secure your spot and experience the next generation before launch.</p>

        <form
          class="wl__form"
          method="post"
          action="#"
          data-demo-form
          data-endpoint={endpoint || undefined}
          data-success-url="/thank-you"
        >
          <label class="visually-hidden" for="wl-email">Email address</label>
          <input class="wl__input" id="wl-email" name="email" type="email" placeholder="name@example.com" autocomplete="email" required />
          <button class="wl__submit" type="submit">Join waitlist</button>
        </form>

        <div class="wl__social">
          <div class="wl__avatars" aria-hidden="true">
            {avatars.map((src) => <img src={src} alt="" width="36" height="36" />)}
          </div>
          <p class="wl__count">Join 3000+ others</p>
        </div>
      </div>

      <footer class="wl__footer">
        <p>© 2026 Parley. For AI agent template</p>
        <p><a href="/terms-conditions">Terms&amp;Conditions</a></p>
      </footer>
    </div>

    <div class="wl__right">
      <img src="/assets/waitlist-app.webp" alt="Parley AI agent Astro template interface preview" />
    </div>
  </div>
</Bare>
