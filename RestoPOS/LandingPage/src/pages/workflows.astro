---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import WorkflowGrid from '../components/sections/WorkflowGrid.astro';
import BuildYourOwn from '../components/sections/BuildYourOwn.astro';
import FeaturedComparison from '../components/sections/FeaturedComparison.astro';
import { group, type Stat } from '../lib/content';
const stats = await group<Stat>('workflowStats');
---
<Base
  title="AI Agent Workflow Template Pages | Parley"
  description="Showcase prebuilt AI agent workflows with Parley, an Astro template for automation products, SaaS startups, and agent-led service pages."
  path="/workflows"
>
  <PageHero
    badge="Workflows"
    lede="Parley comes with proven workflows for sales, support, operations, and research — fully customizable without code."
    stats={stats}
  >Prebuilt agent<br />workflows</PageHero>

  <div class="wfhero">
    <img src="/assets/wf-hero.webp" alt="User interface for creating a task" />
  </div>

  <WorkflowGrid />
  <BuildYourOwn />
  <FeaturedComparison />
</Base>
