[TEMPLATE]
# Base URL every API/WebSocket call in the app is built from.
# Leave blank (or omit) to use the default store backend: http://192.168.100.249:5000
NEXT_PUBLIC_API_URL=

# Only used by the Next.js dev-server proxy rewrites, as a fallback when
# NEXT_PUBLIC_API_URL is blank and calls go out same-origin.
API_PROXY_TARGET=http://192.168.100.249:5000
