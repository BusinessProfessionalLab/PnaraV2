/**
 * Pnara live-chat Worker — canonical deployment.
 *
 * Migrated from RestoPOS/LandingPage/CloudflareWorker.js. The Astro widget
 * (RestoPOS/LandingPage/src/components/chat/) talks to this Worker; deploy
 * from THIS directory so `main` resolves correctly.
 *
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Worker name kept as pnara-sup01 so the existing workers.dev URL and the
	// Telegram webhook URL stay unchanged after the migration.
	"name": "pnara-sup01",
	"main": "src/index.js",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * D1 (required for live chat; the legacy contact form works without it,
	 * but /api/chat/* returns 503 `no_storage` when the binding is missing).
	 *
	 * Create once:  wrangler d1 create pnara_chat
	 * Then apply the schema (run from this directory):
	 *   wrangler d1 execute pnara_chat --file=./migrations/0001_chat_init.sql
	 *   wrangler d1 execute pnara_chat --file=./migrations/0001_chat_init.sql --local  # local dev
	 *
	 * IMPORTANT: the binding name must stay "DB" — src/index.js reads env.DB.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pnara_chat",
			"database_id": "64b17b75-8399-4475-937d-45c34d3f86c2"
		}
	],
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 * Note: Use secrets to store sensitive data (TELEGRAM_BOT_TOKEN,
	 * TELEGRAM_WEBHOOK_SECRET via `wrangler secret put` — NEVER here).
	 */
	"vars": {
		// Public demo-form recipients (code fallback exists; prefer setting this).
		// "CONTACT_TELEGRAM_CHAT_IDS": "1304766783,101717055",
		// Support group chat id (e.g. -1001234567890). Required for live chat.
		"SUPPORT_GROUP_ID": "-1000000000000",
		// Comma-separated Telegram user ids allowed to reply as support.
		// Empty = any support-group member (dev only; set in production).
		"SUPPORT_USER_IDS": "",
		// Extra site origins allowed to call the chat API (pnara.ir + localhost
		// are built in; add staging/preview hosts here).
		// "ALLOWED_ORIGINS": "https://staging.pnara.ir"
	}
}
